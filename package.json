{
  "name": "moki-notes",
  "version": "0.1.0",
  "private": false,
  "description": "MOKI便签 · 本地 Markdown 便签与 Agent 记忆树",
  "author": "MOKI",
  "type": "module",
  "main": "dist/desktop/main.js",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:icon": "node scripts/build-icon.mjs",
    "prepare:feishu": "node scripts/prepare-feishu-cli.mjs",
    "build": "npm run build:icon && vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --maxWorkers=1",
    "check": "npm run typecheck && npm test && npm run build",
    "start": "node dist/server/main.js",
    "desktop": "npm run build && electron .",
    "desktop:built": "electron .",
    "mcp": "node dist/mcp/server.js",
    "test:mcp": "node scripts/mcp-smoke.mjs",
    "package:win": "npm run build && node scripts/package-desktop.cjs",
    "package:installer": "npm run build && node scripts/package-desktop.cjs --installer"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "@floating-ui/dom": "^1.8.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-code-block-lowlight": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-mathematics": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/markdown": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "docx": "^9.5.1",
    "fastify": "^5.6.0",
    "katex": "^0.16.22",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.544.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.9.3",
    "electron-builder": "26.15.3",
    "fflate": "^0.8.2",
    "jsdom": "^29.1.1",
    "playwright": "^1.56.0",
    "sharp": "^0.35.5",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.0.0"
  },
  "build": {
    "appId": "com.moki.notes",
    "productName": "MOKI便签",
    "directories": {
      "output": "release-final"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/feishu-cli/win32-x64",
        "to": "feishu-cli",
        "filter": [
          "lark-cli.exe",
          "LICENSE",
          "manifest.json"
        ]
      }
    ],
    "win": {
      "target": "dir",
      "executableName": "MOKI-Notes",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "artifactName": "MOKI-Notes-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MOKI便签",
      "uninstallDisplayName": "MOKI便签",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ],
      "language": "2052"
    }
  },
  "license": "MIT",
  "homepage": "https://github.com/JKZeng-cell/moki-notes",
  "repository": {
    "type": "git",
    "url": "https://github.com/JKZeng-cell/moki-notes.git"
  },
  "bugs": {
    "url": "https://github.com/JKZeng-cell/moki-notes/issues"
  }
}
