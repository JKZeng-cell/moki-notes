import { contextBridge, ipcRenderer } from 'electron';
contextBridge.exposeInMainWorld('mokiDesktop', {
  appVersion: () => ipcRenderer.invoke('notes:app-version'),
  getStartup: () => ipcRenderer.invoke('notes:startup-get'),
  setStartup: (enabled: boolean) => ipcRenderer.invoke('notes:startup-set', enabled),
  contactDeveloper: () => ipcRenderer.invoke('notes:contact-developer'),
  copyDeveloperEmail: () => ipcRenderer.invoke('notes:copy-developer-email'),
  transferExport: () => ipcRenderer.invoke('notes:transfer-export'),
  transferPreview: () => ipcRenderer.invoke('notes:transfer-preview'),
  transferImport: (ticket: string) => ipcRenderer.invoke('notes:transfer-import', ticket),
  feishuStatus: () => ipcRenderer.invoke('notes:feishu-status'),
  feishuLogin: () => ipcRenderer.invoke('notes:feishu-login'),
  feishuAuthProgress: () => ipcRenderer.invoke('notes:feishu-auth-progress'),
  feishuAuthCancel: () => ipcRenderer.invoke('notes:feishu-auth-cancel'),
  feishuOverview: () => ipcRenderer.invoke('notes:feishu-overview'),
  feishuAutoSave: (settings: unknown) => ipcRenderer.invoke('notes:feishu-auto-save', settings),
  feishuConfigure: (value: { appId: string; secret: string }) => ipcRenderer.invoke('notes:feishu-configure', value),
  feishuResetCli: () => ipcRenderer.invoke('notes:feishu-cli-reset'),
  feishuChooseCli: () => ipcRenderer.invoke('notes:feishu-cli'),
  feishuConnect: (folder?: string) => ipcRenderer.invoke('notes:feishu-connect', folder),
  feishuSync: (direction: string) => ipcRenderer.invoke('notes:feishu-sync', direction),
  pin: (id: string, edit?: boolean) => ipcRenderer.invoke('notes:pin', id, edit),
  unpin: (id: string) => ipcRenderer.invoke('notes:unpin', id),
  pins: () => ipcRenderer.invoke('notes:pins'),
  top: (value: boolean) => ipcRenderer.invoke('notes:top', value),
  manager: (id?: string) => ipcRenderer.invoke('notes:manager', id),
  onSelect: (callback: (id: string) => void) => { const listener = (_event: unknown, id: string) => callback(id); ipcRenderer.on('notes:select', listener); return () => ipcRenderer.removeListener('notes:select', listener); },
  fullscreen: () => ipcRenderer.invoke('notes:fullscreen'),
  close: () => ipcRenderer.invoke('notes:close'),
  cacheInfo: () => ipcRenderer.invoke('notes:cache-info'),
  chooseCache: (reset = false) => ipcRenderer.invoke('notes:cache-choose', reset),
  clearCache: () => ipcRenderer.invoke('notes:cache-clear'),
  importResources: (video = false) => ipcRenderer.invoke('notes:resource-import', video),
  openResource: (resource: unknown) => ipcRenderer.invoke('notes:resource-open', resource),
  saveResource: (resource: unknown) => ipcRenderer.invoke('notes:resource-save', resource),
  copyResourceFile: (resource: unknown) => ipcRenderer.invoke('notes:resource-copy-file', resource),
  copyResourceImage: (data: Uint8Array) => ipcRenderer.invoke('notes:resource-copy-image', data),
  textClipboardAction: (action: 'copy' | 'cut' | 'paste') => ipcRenderer.invoke('notes:text-clipboard', action),
  export: (id: string, format: string) => ipcRenderer.invoke('notes:export', id, format),
});
